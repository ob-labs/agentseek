# Model configuration for the generated DeepAgents application.
AGENTSEEK_MODEL_PROVIDER={{ cookiecutter.default_model_provider }}
AGENTSEEK_MODEL={{ cookiecutter.default_model }}

# Configure one provider credential before starting the agent.
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=
GOOGLE_API_KEY=
GOOGLE_API_BASE=

# Development servers bind to loopback by default. Override both only when the
# generated project must be reachable from another machine or container.
LANGGRAPH_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
