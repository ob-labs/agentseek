# Copy this file to `.env`. AgentSeek lifecycle commands read the variables
# declared in `.agentseek/lifecycle.toml`, and `agentseek dev` starts the full
# Docker Compose stack.

# Model provider. `BUB_MODEL` accepts LangChain model identifiers such as
# `openai:gpt-4o-mini` or an OpenAI-compatible provider-specific model id.
BUB_MODEL={{ cookiecutter.default_model }}

# Required for `agentseek doctor` unless an alias such as OPENAI_API_KEY is set
# in the shell environment.
BUB_API_KEY=

# Optional OpenAI-compatible API base URL. Leave empty for provider defaults.
BUB_API_BASE=

# Gateway and local frontend ports.
BUB_STREAM_OUTPUT=true
BUB_AG_UI_PORT={{ cookiecutter.gateway_port }}
BUB_LANGCHAIN_SPEC={{ cookiecutter.project_slug }}.demo_binding:build_spec
FRONTEND_PORT={{ cookiecutter.frontend_port }}
COPILOTKIT_PORT={{ cookiecutter.copilotkit_port }}
BUB_AG_UI_AGENT_URL=http://127.0.0.1:{{ cookiecutter.gateway_port }}/agent

# Optional Docker build package index settings.
# UV_DEFAULT_INDEX=
# UV_INDEX_URL=
# UV_INSECURE_HOST=

# Optional compose profile: feishu.
# COMPOSE_PROFILES=feishu

# Optional Feishu channel.
AGENTSEEK_FEISHU_APP_ID=
AGENTSEEK_FEISHU_APP_SECRET=
AGENTSEEK_FEISHU_VERIFICATION_TOKEN=
# AGENTSEEK_FEISHU_ENCRYPT_KEY=

# Optional WeCom (企业微信) AI bot channel. `serve-wecom` runs Bub directly,
# so use its native BUB_WECOM_* names here. The long-connection secret must
# remain local; do not commit a filled .env file.
BUB_WECOM_BOT_ID=
BUB_WECOM_SECRET=
# BUB_WECOM_WEBSOCKET_URL=wss://openws.work.weixin.qq.com
# BUB_WECOM_DM_POLICY=open
# BUB_WECOM_ALLOW_FROM=user1,user2
# BUB_WECOM_GROUP_POLICY=open
# BUB_WECOM_GROUP_ALLOW_FROM=wrXXX,wrYYY

# --- LangSmith, optional tracing ------------------------------------------
# Enable LangSmith tracing to inspect agent runs, token usage, and latency.
# Get an API key at https://smith.langchain.com/settings/apikeys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Optional: customize the project name shown in LangSmith UI (defaults to "default").
# LANGSMITH_PROJECT=my-custom-project
# Set LANGSMITH_ENDPOINT for APAC or other non-default regions, e.g.:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# --- OpenTelemetry / Phoenix, optional tracing ----------------------------
# Enabled by default for compose runs so Phoenix receives LangChain spans.
AGENTSEEK_OTEL_ENABLED=true
AGENTSEEK_OTEL_SERVICE_NAME={{ cookiecutter.project_slug }}
AGENTSEEK_OTEL_PROJECT_NAME={{ cookiecutter.project_slug }}
AGENTSEEK_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://phoenix:6006/v1/traces
AGENTSEEK_PHOENIX_IMAGE=ghcr.io/agentseek-ai/agentseek-phoenix:main
OCEANBASE_SEEKDB_IMAGE=quay.io/oceanbase/seekdb:latest
